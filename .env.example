# ---------- LLM (Google Gemini) ----------
# Anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=
MODEL_ID=gemini-2.5-flash
MAX_OUTPUT_TOKENS=4096
# -1: dinamik dusunme (onerilen), 0: dusunme kapali (daha ucuz/hizli, daha zayif karar)
THINKING_BUDGET=-1

# ---------- Vektor DB ----------
# Bos birakilirsa yerel dosya tabanli Qdrant kullanilir (storage/qdrant).
# Qdrant Cloud icin: QDRANT_URL=https://xxx.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=corporate_memory
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=6

# ---------- Log veritabani ----------
# Varsayilan SQLite. Postgres icin:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/agentdb
# DATABASE_URL=

# ---------- Solana ----------
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
# Ajanin operasyon cuzdani: base58 gizli anahtar VEYA JSON byte dizisi.
# Bos birakilirsa tum islemler simule edilir.
AGENT_WALLET_SECRET=
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ---------- Otonom harcama guvenlik sinirlari (kod ile zorunlu) ----------
MAX_SINGLE_PAYMENT_USDC=1000
MAX_DAILY_PAYMENT_USDC=5000
# Virgulle ayrilmis cuzdan listesi. Bos = adres kisiti yok.
ALLOWLISTED_WALLETS=
# true iken zincire hicbir sey yazilmaz, islem simule edilir.
DRY_RUN=true
