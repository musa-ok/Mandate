# ================= Hibrit LLM =================
# true  -> tum ajanlar yerel Ollama'yi kullanir (veri makineden CIKMAZ)
# false -> Google Gemini (bulut)
USE_LOCAL_LLM=false

# --- Bulut: Google Gemini ---  (anahtar: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
MODEL_ID=gemini-2.5-flash
MAX_OUTPUT_TOKENS=8192
THINKING_BUDGET=-1

# --- Yerel: Ollama ---  (kurulum: https://ollama.com ; model: ollama pull qwen2.5:7b)
OLLAMA_HOST=http://localhost:11434
# docker compose icinde (bos -> http://host.docker.internal:11434)
# OLLAMA_HOST_IN_DOCKER=
# Arac cagirmayi destekleyen bir model onerilir (qwen2.5, llama3.1+).
# phi3 gibi desteklemeyenler de calisir (JSON yedek yolu), kalite daha dusuktur.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192

# ================= Dinamik Bilissel Yonlendirme =================
# Sozlesme Analizcisi icin model: cloud | local | default
#   cloud   -> USE_LOCAL_LLM=true olsa bile Gemini kullanir.
#              DIKKAT: sozlesme metinleri Google'a GONDERILIR. GEMINI_API_KEY gerekir;
#              yoksa sozlesme analizi hata verir (sessizce yerel modele dusmez).
#   local   -> her zaman Ollama (veri makineden cikmaz; 7B modelde yavas/isabetsiz)
#   default -> genel USE_LOCAL_LLM ayarini izler
CONTRACT_ANALYST_LLM=cloud
# Satin Alma (tedarikci teklifi degerlendirme): ayni secenekler. Teklif metinleri buluta gider.
PROCUREMENT_LLM=cloud
# Finans ve Musteri Destek: varsayilan genel ayari izler
FINANCE_LLM=default
CUSTOMER_SUPPORT_LLM=default

# ================= Finans =================
# Bu tutara (TL) kadar ve butce yetiyorsa harcama insansiz onaylanir; ustu -> insan onayi
FINANCE_AUTO_APPROVE_LIMIT=10000

# ================= Kurumsal hafiza (Qdrant) =================
# Bos -> yerel dosya tabanli Qdrant (storage/qdrant). Sunucu icin: http://localhost:6333
# docker compose: QDRANT_URL otomatik (http://qdrant:6333); QDRANT_API_KEY ZORUNLU
QDRANT_URL=
QDRANT_API_KEY=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ================= Veri Analisti =================
SQL_MAX_ROWS=200
SQL_TIMEOUT_SECONDS=5

# ================= Sozlesme Analizcisi =================
# Bu seviyeye kadar (dahil) risk insan onayi olmadan gecer: none|low|medium|high|critical
CONTRACT_AUTO_CLEAR_MAX_RISK=low

# ================= Kanal bazli yonlendirme (hava boslugu) =================
# Ic entegrasyonlarin anahtarlari: "kaynak:anahtar", virgulle. Kaynagi istemcinin beyani
# degil bu anahtar belirler. Istekte "X-Source-Key" basligi ile gonderilir.
# Gecerli ic kaynaklar: internal_panel, internal_slack, internal_teams, internal_api
# BOS birakilirsa ic uclar HIC CALISMAZ (503). Dis kanal (/public/support) anahtarsizdir.
INTERNAL_SOURCE_KEYS=

# ================= Musteri destek (public FAQ) =================
# SSS 6000 karakterden buyukse (hibrit arama) en iyi skor bunun altindaysa bot cevap vermez
PUBLIC_FAQ_MIN_SCORE=0.30
# extractive (onerilen): musteri SSS maddesini birebir gorur, halusinasyon imkansiz.
# generative: model kendi yazar; anlam bozulmasi riski var (olculdu).
SUPPORT_REPLY_MODE=extractive

# ================= Insan onayi (AUTH_MODE=keys) =================
# Onay uclarini (/approvals, DELETE /memory) korur. Istekte "X-Admin-Key" basligi gerekir:
#   baslik yok -> 401, yanlis anahtar -> 403.
# ZORUNLU: bos veya 16 karakterden kisaysa onay uclari HIC CALISMAZ (503).
# Uretmek icin: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# ================= Kimlik (SSO) ve rol bazli erisim =================
# keys: paylasilan anahtarlar (demo). Tek yonetici anahtari TUM onaylari verir.
# oidc: kisiler Entra ID / Okta / Google Workspace ile girer; onay yetkisi
#       config/approval_policy.json matrisinden gelir, kimse kendi talebini onaylayamaz.
#       Bu modda X-Admin-Key kabul EDILMEZ; entegrasyonlar X-Source-Key ile talep acabilir.
AUTH_MODE=keys
# Entra ID : https://login.microsoftonline.com/<tenant-id>/v2.0
# Okta     : https://<sirket>.okta.com/oauth2/default
# Google   : https://accounts.google.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# IdP uygulamasindaki istemci dogrulama yontemi: client_secret_post | client_secret_basic (Okta varsayilani)
OIDC_TOKEN_AUTH_METHOD=client_secret_post
# IdP'ye kayitli geri donus adresi (ters vekil arkasinda MUTLAKA yazin)
OIDC_REDIRECT_URI=https://mandate.sirket.com/auth/callback
# Okta'da gruplar icin: "openid email profile groups"
OIDC_SCOPES=openid email profile
# Bearer token ile gelen API istemcileri icin beklenen audience (bos -> OIDC_CLIENT_ID)
OIDC_AUDIENCE=
# Rollerin geldigi claim: Entra app rolleri "roles", Okta "groups". Google grup gondermez:
# rolleri e-postaya gore esleyin (asagida cfo@... ornegi).
OIDC_ROLES_CLAIM=roles
# IdP rol/grup adi veya e-posta -> Mandate rolu. Roller: employee, it_admin, legal,
# finance_manager, cfo, procurement_manager, auditor, admin
OIDC_ROLE_MAP=Mandate.Finance:finance_manager,Mandate.CFO:cfo,Mandate.IT:it_admin,Mandate.Legal:legal,Mandate.Procurement:procurement_manager,Mandate.Audit:auditor,Mandate.Admin:admin
OIDC_DEFAULT_ROLES=employee
# Bos degilse yalnizca bu alan adlarindaki hesaplar girebilir
OIDC_ALLOWED_DOMAINS=
# Oturum cerezini imzalar; AUTH_MODE=oidc iken en az 32 karakter ZORUNLU.
# Degistirmek tum oturumlari hemen sonlandirir.
SESSION_SECRET=
SESSION_TTL_MINUTES=480
# Yalnizca yerel http denemesinde false
SESSION_COOKIE_SECURE=true
# Uygulama Docker'da, IdP'ye tarayicidan farkli bir adresten ulasiyorsa (Keycloak sso-dev):
# OIDC_DISCOVERY_URL_IN_DOCKER=http://keycloak:8080/realms/mandate/.well-known/openid-configuration
# Keycloak sso-dev demosunun hazir degerleri icin bkz. README "SSO demosu".

# ================= Altyapi: PostgreSQL =================
# Bos -> storage/ altindaki SQLite dosyalari (tek sunucu / demo).
# docker compose bunlari otomatik doldurur; yalnizca POSTGRES_PASSWORD gerekir.
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+psycopg://mandate:<sifre>@localhost:5432/mandate
# CHECKPOINT_DATABASE_URL=postgresql://mandate:<sifre>@localhost:5432/mandate

# ================= Sirlar: HashiCorp Vault (KV v2) =================
# VAULT_ADDR doluysa su sirlar Vault'tan okunur ve ortamdakileri ezer:
#   GEMINI_API_KEY, ADMIN_API_KEY, INTERNAL_SOURCE_KEYS, OIDC_CLIENT_SECRET, SESSION_SECRET,
#   DATABASE_URL, CHECKPOINT_DATABASE_URL, QDRANT_API_KEY
# Vault'a ulasilamazsa uygulama BASLAMAZ. Kimlik: VAULT_TOKEN veya AppRole.
VAULT_ADDR=
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_NAMESPACE=
VAULT_KV_MOUNT=secret
VAULT_SECRET_PATH=mandate
